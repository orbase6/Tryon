{
  "name": "Lumen Cinemas",
  "short_name": "Lumen",
  "description": "Book movie tickets and see the view from your seat in 3D before you book.",
  "id": "./",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14161f",
  "theme_color": "#14161f",
  "categories": ["entertainment", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My tickets", "url": "./#tickets", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Partner sign in", "url": "./#login", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
