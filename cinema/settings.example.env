# Copy this file to settings.env and fill it in. settings.env is never uploaded to git.

# First Lumen admin (used only the very first time the server starts with no admin yet)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=ChangeMe123

# Email for OTP codes (password reset, partner registration).
# Gmail: turn on 2-Step Verification, then create an App password at
# https://myaccount.google.com/apppasswords and paste the 16 letters below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=abcdabcdabcdabcd
MAIL_FROM=you@gmail.com

# Where the app listens
PORT=5500
HOST=127.0.0.1
