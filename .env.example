# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tryon_store

# ---------- Auth ----------
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

# ---------- Provider adapters (swap by changing these) ----------
# Background removal: none | heuristic | removebg | imgly
BG_REMOVAL_PROVIDER=heuristic
REMOVEBG_API_KEY=
# Upscale: sharp | replicate
UPSCALE_PROVIDER=sharp
# Try-on / inpainting model: mock | gemini | replicate
TRYON_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image
REPLICATE_API_TOKEN=
# Replicate model version (e.g. cuuupid/idm-vton or a CatVTON version hash)
REPLICATE_TRYON_MODEL=cuuupid/idm-vton
REPLICATE_UPSCALE_MODEL=nightmareai/real-esrgan
# Segmentation / human parsing: client | replicate | heuristic
#   client    -> browser MediaPipe landmarks + multiclass mask sent with the photo (default)
#   heuristic -> landmark/skin-free geometric fallback
SEGMENT_PROVIDER=client

# Face-preservation safety threshold (mean abs pixel diff 0-255 outside the edit mask)
FACE_DIFF_THRESHOLD=14

# ---------- Public (browser) ----------
# Override to self-host MediaPipe model files (see README)
NEXT_PUBLIC_MP_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.21/wasm
NEXT_PUBLIC_MP_POSE_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/latest/pose_landmarker_lite.task
NEXT_PUBLIC_MP_FACE_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task
NEXT_PUBLIC_MP_HAND_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/latest/hand_landmarker.task
NEXT_PUBLIC_MP_SEG_URL=https://storage.googleapis.com/mediapipe-models/image_segmenter/selfie_multiclass_256x256/float32/latest/selfie_multiclass_256x256.tflite
